# PasarGuard v5.6.0: API key must have nodes.read + nodes.update permissions.
SCHEDULER_IMAGE=ghcr.io/h-zare-dev/pasarguard-node-scheduler:development
PANEL_BASE_URL=https://YOUR-PANEL.example.com
TARGET_NODE_ID=66
TARGET_NODE_NAME=IDDidicate-DE
TARGET_CORE_CONFIG_ID=1

# All times are explicitly interpreted in Tehran, not the host timezone.
SCHEDULE_TIMEZONE=Asia/Tehran
NIGHT_START=02:00
NIGHT_END=07:00
NORMAL_COEFFICIENT=1
NIGHT_COEFFICIENT=0
CHECK_INTERVAL_SECONDS=60

# Both gates are required before *any* PasarGuard write is possible.
DRY_RUN=true
PRODUCTION_WRITE_CONFIRMATION=NO

# Set actual credentials ONLY in the untracked .env file on your server.
# Never put real credentials in .env.example or commit them to GitHub.
PANEL_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_ALERT_CHAT_ID=
DATABASE_PATH=/data/scheduler.sqlite
